<odoo noupdate="1">
    <record id="ir_cron_mcp_cleanup" model="ir.cron">
        <field name="name">MCP Cleanup Old Logs</field>
        <field name="model_id" ref="model_mcp_server"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_logs()</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="mcp_tool_search_records" model="mcp.agent.tool">
        <field name="name">search_records</field>
        <field name="model">res.partner</field>
        <field name="method">search_records</field>
        <field name="description">Search records with domain and limit.</field>
        <field name="group_ids" eval="[(4, ref('mcp_connector.group_mcp_user'))]"/>
    </record>
</odoo>
