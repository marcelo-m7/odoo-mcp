<odoo>
    <record id="view_mcp_memory_tree" model="ir.ui.view">
        <field name="name">mcp.memory.context.tree</field>
        <field name="model">mcp.memory.context</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="updated_at"/>
            </list>
        </field>
    </record>

    <record id="action_mcp_memory" model="ir.actions.act_window">
        <field name="name">Memory</field>
        <field name="res_model">mcp.memory.context</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_memory" name="Memory" parent="mcp_connector.menu_mcp_root" action="action_mcp_memory" sequence="30"/>
</odoo>
