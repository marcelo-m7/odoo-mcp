<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_dashboard_tree" model="ir.ui.view">
        <field name="name">mcp.echart.dashboard.tree</field>
        <field name="model">mcp.echart.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_source"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_dashboard_form" model="ir.ui.view">
        <field name="name">mcp.echart.dashboard.form</field>
        <field name="model">mcp.echart.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_source"/>
                        <field name="active"/>
                        <field name="query" widget="json"/>
                        <field name="options" widget="json"/>
                        <field name="media_queries" widget="json"/>
                        <field name="code" widget="text"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">mcp.echart.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
