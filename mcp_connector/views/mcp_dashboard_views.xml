<odoo>
    <record id="view_mcp_dashboard_tree" model="ir.ui.view">
        <field name="name">mcp.echart.dashboard.tree</field>
        <field name="model">mcp.echart.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_source"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_dashboard_form" model="ir.ui.view">
        <field name="name">mcp.echart.dashboard.form</field>
        <field name="model">mcp.echart.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_source"/>
                    </group>
                    <group>
                        <field name="shared_user_ids" widget="many2many_tags"/>
                        <field name="shared_group_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Query"><field name="query" widget="text"/></page>
                        <page string="Options"><field name="options" widget="text"/></page>
                        <page string="Code"><field name="code" widget="text"/></page>
                        <page string="Responsive"><field name="media_queries" widget="text"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">mcp.echart.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_dashboard" name="Dashboards" parent="mcp_connector.menu_mcp_root" action="action_mcp_dashboard" sequence="20"/>
</odoo>
