<odoo>
    <record id="view_mcp_webapp_tree" model="ir.ui.view">
        <field name="name">mcp.webapp.tree</field>
        <field name="model">mcp.webapp</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="slug"/>
                <field name="public_access"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_webapp_form" model="ir.ui.view">
        <field name="name">mcp.webapp.form</field>
        <field name="model">mcp.webapp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="slug"/>
                        <field name="public_access"/>
                    </group>
                    <group>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="endpoints" widget="text"/>
                    </group>
                    <field name="code_js" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_webapp" model="ir.actions.act_window">
        <field name="name">Web Apps</field>
        <field name="res_model">mcp.webapp</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_webapp" name="Web Apps" parent="mcp_connector.menu_mcp_root" action="action_mcp_webapp" sequence="25"/>
</odoo>
