<odoo>
    <record id="view_mcp_activity_log_tree" model="ir.ui.view">
        <field name="name">mcp.activity.log.tree</field>
        <field name="model">mcp.activity.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="tool_id"/>
                <field name="status"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>

    <record id="action_mcp_activity_log" model="ir.actions.act_window">
        <field name="name">Activity Logs</field>
        <field name="res_model">mcp.activity.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_activity_log" name="Activity Logs" parent="mcp_connector.menu_mcp_root" action="action_mcp_activity_log" sequence="40" groups="mcp_connector.group_mcp_manager"/>
</odoo>
