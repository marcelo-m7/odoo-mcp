<odoo>
    <record id="view_mcp_tool_tree" model="ir.ui.view">
        <field name="name">mcp.agent.tool.tree</field>
        <field name="model">mcp.agent.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="model"/>
                <field name="method"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_tool_form" model="ir.ui.view">
        <field name="name">mcp.agent.tool.form</field>
        <field name="model">mcp.agent.tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model"/>
                        <field name="method"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="return_type" widget="text"/>
                    </group>
                    <field name="description" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">mcp.agent.tool</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mcp_tools" name="Tools" parent="mcp_connector.menu_mcp_configuration" action="action_mcp_tool" sequence="20"/>
</odoo>
