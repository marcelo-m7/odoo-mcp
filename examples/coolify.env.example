# Add these as RUNTIME environment variables in Coolify; never commit real values.
ODOO_MCP_TRANSPORT=streamable-http
MCP_PUBLIC_URL=https://mcp.example.org/mcp
MCP_OAUTH_ISSUER=https://id.example.org/realms/monynha
MCP_OAUTH_INTROSPECTION_URL=https://id.example.org/realms/monynha/protocol/openid-connect/token/introspect
MCP_OAUTH_CLIENT_ID=mcp-resource
MCP_OAUTH_CLIENT_SECRET=REPLACE_WITH_SECRET
MCP_OAUTH_ALLOWED_SUBJECTS=REPLACE_WITH_OPERATOR_SUB
MCP_OAUTH_REQUIRED_SCOPE=odoo:mcp

# Only enable after setting a real connection and an appropriate Odoo key.
ODOO_MCP_OPERATIONS_ENABLED=1
ODOO_MCP_CONNECTIONS_JSON=[{"id":"facodi","base_url":"https://facodi.com","protocol":"json2","secret_env":"ODOO_FACODI_API_KEY"}]
ODOO_FACODI_API_KEY=REPLACE_WITH_ODOO_API_KEY
# Omit ODOO_MCP_WRITE_POLICY_JSON for deny-by-default write policy.
